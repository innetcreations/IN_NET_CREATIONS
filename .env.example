# ============================================================
# IN NET CREATIONS — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git — it is in .gitignore
#
# For Vercel deployment, add these via:
#   Project Settings → Environment Variables
# ============================================================

# ── EmailJS (Contact & Book a Call forms) ──────────────────
# Find these in https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_330d74d
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ── Admin CMS ──────────────────────────────────────────────
# Set your admin password (the one you'll type at /admin/login)
ADMIN_PASSWORD=your_secure_admin_password_here

# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# Or online: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your_random_secret_here_run_openssl_rand_base64_32

# NEXTAUTH_URL must match your deployment URL exactly
# Development:
NEXTAUTH_URL=http://localhost:3000
# Production (uncomment and set when deploying):
# NEXTAUTH_URL=https://in-net-creations.vercel.app

# ── CMS Storage (GitHub API) ────────────────────────────────
# Required for saving CMS changes on Vercel (read-only filesystem).
# The CMS will commit changes directly to your GitHub repo.
#
# 1. Go to: https://github.com/settings/tokens/new
# 2. Select scope: "repo" (full control of private repositories)
#    OR for public repos: "public_repo"
# 3. Copy the generated token below
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Your GitHub repository in "owner/repo" format
GITHUB_REPO=innetcreations/IN_NET_CREATIONS

# The branch to commit CMS changes to (default: main)
GITHUB_BRANCH=main
